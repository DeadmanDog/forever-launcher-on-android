#include <vulkan/vulkan.h>
#include <algorithm>
#include <atomic>
#include <chrono>
#include <cstdio>
#include <cstdlib>
#include <mutex>
#include <shared_mutex>
#include <thread>
#include <unordered_map>
#include <vector>
#include "RenderWakeSignal.h"
#define RLOG(...)
struct VulkanRendererContext {
 mutable std::shared_mutex frameMutex;std::mutex renderMutex;RenderWakeSignal renderWake;
 int filterMode=0,activeEffectId=0,activeEffectMask=0;bool cubicSupported=false,swapRB=false;
 float activeSharpness=1,activeBrightness=0,activeContrast=0,activeGamma=1;
 std::atomic<bool>needsRender{false},fbResized{false},gpuTouched{false};std::atomic<uint64_t>sceneGen{1},contentGen{0};void markSceneDirty(){sceneGen.fetch_add(1);needsRender.store(true);}
 VkDevice device=VK_NULL_HANDLE;VkSampler sampler=VK_NULL_HANDLE;VkDescriptorSet cursorDS=VK_NULL_HANDLE;VkImageView cursorView=VK_NULL_HANDLE;
 struct Tex{VkDescriptorSet ds=VK_NULL_HANDLE;VkImageView view=VK_NULL_HANDLE;};std::unordered_map<int,Tex>texMap,ahbImportCache;
 struct Dispatch {std::atomic<bool>*touched;VkResult DeviceWaitIdle(VkDevice){*touched=true;return VK_SUCCESS;}void DestroySampler(VkDevice,VkSampler,const VkAllocationCallbacks*){}void UpdateDescriptorSets(VkDevice,uint32_t,const VkWriteDescriptorSet*,uint32_t,const VkCopyDescriptorSet*){}}vk_{&gpuTouched};
 void createSampler(){}
 VkPresentModeKHR requestedPresentMode=VK_PRESENT_MODE_FIFO_KHR;std::vector<VkPresentModeKHR>availablePresentModes{VK_PRESENT_MODE_FIFO_KHR,VK_PRESENT_MODE_MAILBOX_KHR};
 void setFilterMode(int);void setEffect(int,float,int,float,float,float);void setSwapRB(bool);void setPresentMode(VkPresentModeKHR);
};
/* PRODUCTION */
static void check(bool b,const char*m){if(!b){fprintf(stderr,"FAIL %s\n",m);exit(2);}}
int main(int,char**argv){int n=atoi(argv[1]);VulkanRendererContext c;
 std::shared_lock<std::shared_mutex>recording(c.frameMutex);std::unique_lock<std::mutex>importing(c.renderMutex,std::defer_lock);if(n==2||n==3){recording.unlock();importing.lock();}
 std::atomic<bool>started{false},done{false};std::thread setter([&]{started=true;if(n==1)c.setEffect(2,.5f,3,0,0,1);else if(n==3)c.setSwapRB(true);else if(n==4)c.setPresentMode(VK_PRESENT_MODE_MAILBOX_KHR);else c.setFilterMode(1);done=true;});
 while(!started)std::this_thread::yield();auto until=std::chrono::steady_clock::now()+std::chrono::milliseconds(50);while(std::chrono::steady_clock::now()<until&&!done)std::this_thread::yield();
 bool unsafe=(n==1||n==3||n==4)?done.load():c.gpuTouched.load();if(recording.owns_lock())recording.unlock();if(importing.owns_lock())importing.unlock();setter.join();
 check(!unsafe,n==0?"sampler destruction overlaps CPU frame recording":n==1?"effect constants change during frame recording":"filter rewrite overlaps import/cache mutation");
 check(done&&(n==3?c.swapRB:n==4?c.fbResized.load():c.needsRender.load()),"settings apply after active owner releases gate");puts("PASS settings ownership");
}

 		// The Android cursor plane is displayed independently of the game's buffer.
 		// Keep the original shape and hotspot, with a readable minimum size at 1:1.
 		const float imageExtent = std::max(m_texture->contentWidth(), m_texture->contentHeight());
-		const float readableScale = 48.0f / imageExtent;
+		// The 48-pixel readable minimum is meant in display pixels: with a game-sized output the panel enlarges the

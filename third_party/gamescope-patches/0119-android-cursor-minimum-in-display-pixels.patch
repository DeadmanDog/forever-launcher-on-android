+		static const float readablePixels = [] {
+			const char *value = getenv("GNDRM_CURSOR_MIN_PX");
+			const float pixels = value ? strtof(value, nullptr) : 0.0f;
+			return pixels > 0.0f ? pixels : 48.0f;
+		}();
+		const float readableScale = readablePixels / imageExtent;
 		cursor_scale = std::max({ cursor_scale, readableScale, std::min(currentScaleRatio_x, currentScaleRatio_y) });
 	}
 	cursor_scale = std::max(cursor_scale, 1.0f);
